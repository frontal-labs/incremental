{
  "name": "fixture-root",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fixture-root",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@fixture/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/@fixture/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/app": {
      "name": "@fixture/app"
    },
    "packages/core": {
      "name": "@fixture/core"
    }
  }
}
