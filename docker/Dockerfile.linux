# Linux check of the whole test target (PLAN 17.1 linux-gate).
# Deviation (recorded in DECISIONS.md): the container runs the released Goose
# linux-x64 binary under amd64 emulation. Goose has no linux-arm64 release and
# building it from source is not documented in the release, so it is not done here.
FROM --platform=linux/amd64 node:22-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends git python3 python3-pip make curl ca-certificates tar build-essential strace protobuf-compiler \
 && rm -rf /var/lib/apt/lists/*

# Rust toolchain (cargo) for adapters that need it.
RUN curl -fsSL --retry 5 --retry-all-errors --retry-delay 10 https://sh.rustup.rs | sh -s -- -y --profile minimal \
 && /root/.cargo/bin/rustup default stable

# pnpm, buf and bazelisk come from npm (the same pins as release.yml). GitHub release downloads
# returned 503 from the Actions network, so they are not used here.
RUN npm install -g pnpm@9.0.0 @bufbuild/buf@1.70.0 @bazel/bazelisk@1.28.1 \
 && ln -sf "$(npm prefix -g)/bin/bazelisk" /usr/local/bin/bazel

# ruff
RUN pip3 install --no-cache-dir --break-system-packages ruff

ENV PATH=/root/.cargo/bin:$PATH

# Pinned to the release's published SHA-256 (same digest as scripts/fetch-goose.sh).
RUN mkdir -p /opt/goose \
 && curl -fsSL --retry 5 --retry-all-errors --retry-delay 10 -o /tmp/goose.tar.gz https://github.com/aardappel/goose/releases/download/v2026.3/goose-v2026.3-linux-x64.tar.gz \
 && echo "06ac30284338269d3996d457412bf4f2b47c1f9a5601de65b6317187fe78d5c9  /tmp/goose.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/goose.tar.gz -C /opt/goose \
 && rm /tmp/goose.tar.gz

ENV PATH=/root/.cargo/bin:/usr/local/bin:$PATH \
    GOOSE_DIR=/opt/goose/goose-v2026.3-linux-x64 \
    GOOSE_HOME=/app/.toolchain/goose-home \
    GOOSE_CC=/usr/bin/cc

WORKDIR /app
COPY . /app

# Root devDependencies (tsc-rs, used by make build) and the pnpm workspace packages.
RUN pnpm install --frozen-lockfile

# Build the engine and Node packages from source.
RUN make build
RUN for d in bindings/node adapters/vitest adapters/typescript adapters/config adapters/env adapters/fs adapters/process adapters/strace adapters/biome adapters/clippy adapters/bazel adapters/playwright adapters/pnpm adapters/protobuf adapters/ruff adapters/turbopack adapters/watcher benchmarks/replay mcp; do (cd "$d" && npm install --no-audit --no-fund); done

CMD ["make", "all-tests", "test-python", "test-git", "test-fuzz"]
