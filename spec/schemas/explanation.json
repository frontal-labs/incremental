{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["task", "observed", "certificate"],
  "properties": {
    "task": { "type": "string" },
    "observed": { "type": "boolean" },
    "outcome": { "enum": ["pass", "fail", "error", "none"] },
    "dirty": { "type": "boolean" },
    "baseline": { "type": "string" },
    "inputs": { "type": "integer" },
    "certificate": { "type": "boolean" }
  }
}
