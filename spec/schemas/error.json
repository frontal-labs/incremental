{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "enum": [
        "invalid_params",
        "unknown_method",
        "protocol_mismatch",
        "store_missing",
        "store_corrupt",
        "lock_busy",
        "baseline_conflict",
        "timeout",
        "internal"
      ]
    },
    "message": { "type": "string" },
    "data": { "type": "object" }
  }
}
