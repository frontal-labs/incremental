.env
!.env.example

# typescript
*.tsbuildinfo
tests/types/next-env.d.ts

*storybook.log
storybook-static

# Playwright
/test-results
/playwright-report
/playwright-browsers

# MCP
.playwright-*
.env*
/dist/
.cloudflare/

