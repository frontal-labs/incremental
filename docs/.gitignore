# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# fumadocs
/.source/

# framework build output
/.tanstack/
/out/

# generated sitemaps
/public/sitemap.xml
/public/sitemap-*.xml

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
