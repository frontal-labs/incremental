{
  "name": "incremental-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Incremental Compute Engine — developer documentation",
  "keywords": [
    "docs",
    "documentation",
    "incremental",
    "incremental-compute",
    "reactjs",
    "shadcn",
    "tanstack",
    "tanstack-start",
    "typescript"
  ],
  "homepage": "https://incremental.dev",
  "bugs": {
    "url": "https://github.com/incremental-labs/incremental/issues"
  },
  "author": "Gabriel Fonseca <gabriel@incremental.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/incremental-labs/incremental"
  },
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production vite build && tsc --noEmit",
    "build:tanstack": "bun run build",
    "check": "ultracite check",
    "clean": "git clean -xdf .cloudflare .tanstack .turbo node_modules",
    "deploy": "bun run build && cf deploy",
    "dev": "TZ=UTC vite dev",
    "preview": "vite preview",
    "fix": "ultracite fix",
    "postinstall": "node scripts/patch-cloudflare-react-eval.mjs",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "precommit": "bun run secrets:scan && bun run verify",
    "prepare": "husky",
    "secrets:scan": "gitleaks protect --staged --redact --no-banner",
    "start": "vite preview",
    "sync": "bun scripts/sync-registry.js",
    "sync:check": "bun scripts/sync-registry.js --check",
    "sync:install": "bun scripts/sync-registry.js --install",
    "test": "vitest run",
    "test:component": "vitest run tests/components",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:debug": "PWDEBUG=1 playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "typecheck": "bun run typegen && tsc --noEmit",
    "typegen": "cf workers types && fumadocs-mdx",
    "verify": "bun run lint && bun run typecheck && bun run test -- --passWithNoTests",
    "verify:e2e": "bun run build && PLAYWRIGHT_WEB_SERVER_COMMAND='bun run preview' bun run test:e2e",
    "verify:production": "bun run verify && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "^0.3.1",
    "@shikijs/transformers": "^4.5.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "@testing-library/dom": "^10.4.2",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.109",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "feed": "^6.0.0",
    "fumadocs-core": "^16.16.1",
    "fumadocs-mdx": "^15.4.6",
    "fumadocs-ui": "^16.16.1",
    "geist": "^1.7.0",
    "input-otp": "^1.5.0",
    "jotai": "^3.0.1",
    "lucide-react": "^1.46.0",
    "media-chrome": "^4.19.3",
    "mermaid": "^12.1.0",
    "motion": "^13.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.10.1",
    "rehype-pretty-code": "^0.14.5",
    "schema-dts": "^2.1.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.17",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "@vitest/coverage-v8": "^5.0.3",
    "cf": "^1.0.0-rc.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "oxfmt": "latest",
    "oxlint": "latest",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "ultracite": "7.12.3",
    "vite": "8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@base-ui/react": "1.8.0",
    "motion": "^13.2.0",
    "next-themes": "^0.4.6",
    "proxy-addr": "2.0.8"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "allowScripts": {
    "sharp": true,
    "esbuild": true,
    "@swc/core": true,
    "@parcel/watcher": true,
    "core-js": false,
    "msw": false
  }
}
