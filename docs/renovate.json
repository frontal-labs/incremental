{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":prHourlyLimit2",
    ":prConcurrentLimit10"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Group low-risk JavaScript dependency updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "non-major dependencies",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Require review for React and Next.js updates.",
      "matchPackageNames": ["next", "react", "react-dom"],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Keep test tooling updates together.",
      "matchPackageNames": ["@playwright/test", "vitest", "@vitest/**"],
      "groupName": "test tooling"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security", "dependencies"]
  }
}
