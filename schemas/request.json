{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://backplane.dev/schemas/request.json",
  "title": "Request",
  "description": "One JSON Lines request sent to the engine over stdio.",
  "type": "object",
  "required": ["id", "method"],
  "properties": {
    "id": {"type": "integer"},
    "method": {
      "type": "string",
      "enum": ["hello", "observe", "observe_many", "baseline", "advance", "affected", "explain", "forget", "stats", "compact", "ping", "shutdown"]
    },
    "params": {"type": "object"}
  }
}
