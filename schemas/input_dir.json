{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://backplane.dev/schemas/input_dir.json",
  "title": "Input Dir",
  "type": "object",
  "required": ["kind", "path"],
  "properties": {
    "kind": {"const": "dir"},
    "path": {"type": "string", "description": "Repo-relative path with / separators, canonical (realpath) resolved."}
  }
}
