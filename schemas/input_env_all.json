{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://incremental.dev/schemas/input_env_all.json",
  "title": "Input Env All",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "kind": {"const": "env_all"},
    "snapshot": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "Full environment hash map at observation time. Without it, env_all is treated as changed."
    }
  }
}
