{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://backplane.dev/schemas/index.json",
  "title": "Backplane Schemas Index",
  "description": "Index of all backplane JSON schemas.",
  "type": "object",
  "required": ["schemas"],
  "properties": {
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "description"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    }
  }
}
