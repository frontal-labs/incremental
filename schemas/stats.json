{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://incremental.dev/schemas/stats.json",
  "title": "Stats",
  "description": "Store statistics returned by the stats method.",
  "type": "object",
  "required": ["tasks", "observations", "baseline", "graph_version"],
  "additionalProperties": true,
  "properties": {
    "tasks": { "type": "integer", "minimum": 0 },
    "observations": { "type": "integer", "minimum": 0 },
    "baseline": { "type": ["string", "null"] },
    "graph_version": { "type": "string", "pattern": "^g_[0-9a-f]{8}$" }
  }
}
