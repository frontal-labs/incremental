{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://incremental.dev/schemas/error.json",
  "title": "Error",
  "description": "Protocol error object returned by the engine.",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "enum": ["invalid_params", "unknown_method", "protocol_mismatch", "store_missing", "store_corrupt", "lock_busy", "baseline_conflict", "timeout", "internal"]
    },
    "message": {"type": "string"},
    "data": {"type": "object"}
  }
}
