{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://incremental.dev/schemas/response.json",
  "title": "Response",
  "description": "One JSON Lines response from the engine. Exactly one of result or error.",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {"type": ["integer", "null"]},
    "result": {},
    "error": {"$ref": "error.json"}
  },
  "oneOf": [
    {"required": ["result"], "not": {"required": ["error"]}},
    {"required": ["error"], "not": {"required": ["result"]}}
  ]
}
