{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://incremental.dev/schemas/plan.json",
  "title": "Plan",
  "description": "Engine's answer to an affected query: which tasks are invalid and why.",
  "type": "object",
  "required": ["protocol", "baseline", "graph_version", "verify", "tasks", "unobserved", "ignored", "deleted_tasks", "total_tasks", "skipped", "fallback", "confidence"],
  "additionalProperties": true,
  "properties": {
    "protocol": {"const": 1},
    "baseline": {"type": "string"},
    "graph_version": {"type": "string", "pattern": "^g_[0-9a-f]{8}$"},
    "verify": {"type": "boolean"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reasons"],
        "properties": {
          "id": {"type": "string"},
          "reasons": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "unobserved": {"type": "array", "items": {"type": "string"}},
    "ignored": {"type": "array", "items": {"type": "string"}},
    "deleted_tasks": {"type": "array", "items": {"type": "string"}},
    "total_tasks": {"type": "integer", "minimum": 0},
    "skipped": {"type": "integer", "minimum": 0},
    "fallback": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["action", "reason"],
          "properties": {
            "action": {"type": "string", "enum": ["run_all"]},
            "reason": {
              "type": "string",
              "enum": ["baseline_mismatch", "context_missing", "global_input", "context_changed", "unobserved_input"]
            }
          }
        }
      ]
    },
    "confidence": {"type": "string", "enum": ["high", "medium", "n/a"]}
  }
}
