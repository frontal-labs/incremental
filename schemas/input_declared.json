{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://backplane.dev/schemas/input_declared.json",
  "title": "Input Declared",
  "type": "object",
  "required": ["kind", "path", "hash"],
  "properties": {
    "kind": {"const": "declared"},
    "path": {"type": "string", "description": "Repo-relative path declared as an input without an observed read."},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
