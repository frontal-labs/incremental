{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://incremental.dev/schemas/store_record.json",
  "title": "Store Record",
  "description": "One line of tg.log, the append-only JSON Lines log that is the source of truth for the store.",
  "type": "object",
  "required": ["r"],
  "discriminator": {
    "propertyName": "r",
    "mapping": {
      "hdr": "#/$defs/hdr",
      "obs": "#/$defs/obs",
      "forget": "#/$defs/forget",
      "baseline": "#/$defs/baseline"
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/hdr"},
    {"$ref": "#/$defs/obs"},
    {"$ref": "#/$defs/forget"},
    {"$ref": "#/$defs/baseline"}
  ],
  "$defs": {
    "hdr": {
      "type": "object",
      "required": ["r", "v", "hash", "created"],
      "properties": {
        "r": {"const": "hdr"},
        "v": {"const": 1},
        "hash": {"const": "sha256"},
        "created": {"type": "string", "format": "date-time"}
      }
    },
    "obs": {
      "type": "object",
      "required": ["r", "task", "baseline", "dirty", "context", "inputs", "outcome"],
      "properties": {
        "r": {"const": "obs"},
        "task": {"type": "string"},
        "baseline": {"type": "string"},
        "dirty": {"type": "boolean"},
        "context": {"$ref": "context.json"},
        "inputs": {"type": "array"},
        "outputs": {"type": "array"},
        "outcome": {"type": "string", "enum": ["pass", "fail", "error", "none"]},
        "duration_ms": {"type": "number"},
        "at": {"type": "string", "format": "date-time"}
      }
    },
    "forget": {
      "type": "object",
      "required": ["r", "task"],
      "properties": {
        "r": {"const": "forget"},
        "task": {"type": "string"}
      }
    },
    "baseline": {
      "type": "object",
      "required": ["r", "value", "at"],
      "properties": {
        "r": {"const": "baseline"},
        "value": {"type": "string"},
        "at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
