{
  "name": "@backplane/root",
  "version": "0.0.0",
  "private": true,
  "description": "High-performance incremental computation engine for building dependency-driven systems.",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "prepare": "husky",
    "ci:version": "changeset version && pnpm install --no-lockfile",
    "release:publish": "pnpm --filter '*' run build && changeset publish"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/backplane.git"
  },
  "bugs": {
    "url": "https://github.com/frontal-labs/backplane/issues"
  },
  "homepage": "https://github.com/frontal-labs/backplane#readme",
  "author": "Frontal Labs, Inc.",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "turbo": "^2.11.10",
    "typescript": "^5.6.0",
    "ultracite": "^8.1.1",
    "vitest": "^2.1.0"
  }
}
